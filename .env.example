# ---------------------------------------------------------------------------
# Backend de LLM — escolha UM caminho. Tudo é opcional: sem nenhuma variável
# definida, o autodiag simplesmente pula a análise por IA.
# ---------------------------------------------------------------------------

# 1) Anthropic (padrão quando a chave existe)
ANTHROPIC_API_KEY=sk-ant-...

# 2) Qualquer endpoint OpenAI-compatible — exige: pip install 'autodiag[openai]'
#    OpenAI
# OPENAI_API_KEY=sk-...
#    OpenRouter
# AUTODIAG_BASE_URL=https://openrouter.ai/api/v1
# AUTODIAG_API_KEY=sk-or-v1-...
#    Ollama local (sem credencial)
# AUTODIAG_BASE_URL=http://localhost:11434/v1
#    LM Studio local (sem credencial)
# AUTODIAG_BASE_URL=http://localhost:1234/v1

# ---------------------------------------------------------------------------
# Ajustes opcionais
# ---------------------------------------------------------------------------
# Modelo: default claude-opus-5 (anthropic) ou gpt-4.1-mini (openai)
# AUTODIAG_MODEL=claude-opus-5
# Força um backend em vez de deixar a resolução automática
# AUTODIAG_LLM_BACKEND=auto        # auto | anthropic | openai
